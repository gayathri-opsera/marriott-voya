{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "bookable": {
      "type": "boolean"
    },
    "dataClassification": {
      "default": "INTERNAL",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "RESTRICTED",
        "CONFIDENTIAL"
      ],
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "type": "string"
    },
    "freshnessAt": {
      "format": "date-time",
      "type": "string"
    },
    "isMock": {
      "type": "boolean"
    },
    "offerId": {
      "minLength": 1,
      "type": "string"
    },
    "offerType": {
      "enum": [
        "ACCOMMODATION",
        "FLIGHT",
        "ACTIVITY",
        "TRANSPORT",
        "RESTAURANT",
        "NOTE"
      ],
      "type": "string"
    },
    "priceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "minLength": 1,
          "type": "string"
        },
        "currency": {
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "type": "object"
    },
    "provenance": {
      "enum": [
        "HVMI",
        "MARRIOTT_HOTEL",
        "MARRIOTT_PARTNER",
        "AMADEUS",
        "RAPIDAPI_HOTEL",
        "RAPIDAPI_CAR",
        "BONVOY_TOURS",
        "GOOGLE_PLACES",
        "WEATHER_SERVICE",
        "ILLUSTRATIVE"
      ],
      "type": "string"
    }
  },
  "required": [
    "offerId",
    "provenance",
    "freshnessAt",
    "bookable",
    "isMock",
    "offerType"
  ],
  "type": "object"
}
