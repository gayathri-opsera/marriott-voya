{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "additionalProperties": false,
      "properties": {
        "anonymousId": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "enum": [
            "authenticated",
            "anonymous"
          ],
          "type": "string"
        },
        "userId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "changeReason": {
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "diffSummary": {
      "type": "string"
    },
    "draftId": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "revisionNumber": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "draftId",
    "revisionNumber",
    "actor",
    "createdAt"
  ],
  "type": "object"
}
