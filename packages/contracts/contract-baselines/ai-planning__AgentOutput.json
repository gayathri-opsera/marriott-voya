{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "agentName": {
      "enum": [
        "safety",
        "accommodation",
        "restaurant",
        "attraction",
        "activity",
        "local_transport",
        "weather",
        "flight",
        "budget",
        "itinerary"
      ],
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "errorSummary": {
      "maxLength": 500,
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "inputs": {
      "additionalProperties": {},
      "type": "object"
    },
    "normalizedResult": {
      "additionalProperties": {},
      "type": "object"
    },
    "provenance": {
      "enum": [
        "HVMI",
        "MARRIOTT_HOTEL",
        "MARRIOTT_PARTNER",
        "AMADEUS",
        "RAPIDAPI_HOTEL",
        "RAPIDAPI_CAR",
        "BONVOY_TOURS",
        "GOOGLE_PLACES",
        "WEATHER_SERVICE",
        "ILLUSTRATIVE"
      ],
      "type": "string"
    },
    "sessionId": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "skipped",
        "blocked",
        "degraded",
        "timeout",
        "failed"
      ],
      "type": "string"
    },
    "toolResults": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bookable": {
            "type": "boolean"
          },
          "dataClassification": {
            "default": "INTERNAL",
            "enum": [
              "PUBLIC",
              "INTERNAL",
              "RESTRICTED",
              "CONFIDENTIAL"
            ],
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "freshnessAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "isMock": {
            "type": "boolean"
          },
          "normalizedPayload": {
            "additionalProperties": {},
            "type": "object"
          },
          "source": {
            "enum": [
              "HVMI",
              "MARRIOTT_HOTEL",
              "MARRIOTT_PARTNER",
              "AMADEUS",
              "RAPIDAPI_HOTEL",
              "RAPIDAPI_CAR",
              "BONVOY_TOURS",
              "GOOGLE_PLACES",
              "WEATHER_SERVICE",
              "ILLUSTRATIVE"
            ],
            "type": "string"
          },
          "toolName": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "toolName",
          "source",
          "freshnessAt",
          "bookable",
          "isMock",
          "normalizedPayload"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "turnId": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "sessionId",
    "agentName",
    "status",
    "inputs",
    "createdAt"
  ],
  "type": "object"
}
